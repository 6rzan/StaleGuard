# Mock mode: bundled fixtures, no network, no keys. Required (true or false).
MOCK_MODE=true
# Bifrost gateway base URL (chat completions API). Required when MOCK_MODE=false.
BIFROST_BASE_URL=http://127.0.0.1:8080
# Bearer key for the Bifrost gateway. Optional.
BIFROST_API_KEY=
# Bifrost virtual key sent with each request. Optional.
BIFROST_VIRTUAL_KEY=
# Model for claim extraction. Required.
MODEL_EXTRACT=groq/openai/gpt-oss-120b
# Model for judging evidence. Required.
MODEL_JUDGE=groq/openai/gpt-oss-120b
# Model for the Ask mode answer. Required.
MODEL_ANSWER=xai/grok-4.7
# Comma-separated fallback models used on failover. Optional.
MODEL_FALLBACKS=xai/grok-4.7
# Tavily search API key. Required when MOCK_MODE=false.
TAVILY_API_KEY=
# Maximum number of flagged claims verified per check. Optional.
MAX_CLAIMS=8
# SQLite file path. Optional.
DATABASE_PATH=data/staleguard.db

# Provider keys below are read by Bifrost, not by the app.
# Groq provider key (https://console.groq.com/keys), read by Bifrost, not by the app. Optional.
GROQ_API_KEY=
# xAI provider key (https://console.x.ai), read by Bifrost, not by the app. Optional.
XAI_API_KEY=
# Reuse verified claims for a while (high 6 h, medium 24 h, low 7 d). Optional.
CACHE_ENABLED=true
